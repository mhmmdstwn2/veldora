{
  "name": "veldora",
  "version": "1.0.0",
  "description": "VELDORA - Professional Local-first PDF Editor",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-electron/main.cjs --external:electron --external:electron-updater && esbuild electron/preload.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-electron/preload.cjs --external:electron",
    "electron:dev": "vite",
    "electron:build": "tsc && vite build && npm run build:electron && electron-builder"
  },
  "dependencies": {
    "@embedpdf/viewer-react": "^3.3.0",
    "@fontsource/dejavu-sans": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "clsx": "^2.1.1",
    "docx": "^9.16.0",
    "electron-updater": "^6.8.11",
    "idb": "^8.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.475.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pako": "^2.0.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}